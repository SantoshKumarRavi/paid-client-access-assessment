{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "server-dist/**/*.js"
    }
  },
  "crons": [
    {
      "path": "/api/cron/crm",
      "schedule": "0 0 * * *"
    }
  ]
}
